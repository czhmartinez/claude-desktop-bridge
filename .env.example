BRIDGE_DOMAIN=bridge.example.com
BRIDGE_ALLOWED_ORIGINS=https://bridge.example.com,capacitor://localhost
BRIDGE_PUBLIC_RELAY_URL=wss://bridge.example.com/ws
BRIDGE_SERVICE_ORIGIN=https://bridge.example.com
BRIDGE_RELAY_DATA=/data/bridge-relay.db
BRIDGE_RELAY_BACKUP_DIR=/data/backups

# Use the same fixed endpoint when building the Android/iOS client.
VITE_BRIDGE_PUBLIC_RELAY_URL=wss://bridge.example.com/ws
VITE_BRIDGE_SERVICE_ORIGIN=https://bridge.example.com
VITE_BRIDGE_PUSH_ENABLED=true

# Android content-free wake notifications
BRIDGE_FCM_PROJECT_ID=
BRIDGE_FCM_CLIENT_EMAIL=
BRIDGE_FCM_PRIVATE_KEY=

# iOS content-free wake notifications
BRIDGE_APNS_TEAM_ID=
BRIDGE_APNS_KEY_ID=
BRIDGE_APNS_BUNDLE_ID=com.localbridge.mobile
BRIDGE_APNS_PRIVATE_KEY=
BRIDGE_APNS_PRODUCTION=1
