{
  "name": "@bridge/desktop",
  "productName": "Bridge",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "npm run build -w @bridge/client && node scripts/build.mjs",
    "build:bundle": "node scripts/build.mjs",
    "build:main": "node scripts/build.mjs --main-only",
    "clean": "rm -rf dist out coverage",
    "dev": "npm run build:main && cross-env BRIDGE_DEV_SERVER_URL=http://localhost:5188 electron .",
    "make": "npm run build && electron-forge make",
    "make:adhoc": "cross-env BRIDGE_ALLOW_ADHOC_SIGNING=1 npm run make",
    "make:local-signed": "zsh scripts/make-local-macos-signed.zsh make",
    "package": "npm run build && electron-forge package",
    "package:adhoc": "cross-env BRIDGE_ALLOW_ADHOC_SIGNING=1 npm run package",
    "package:local-signed": "zsh scripts/make-local-macos-signed.zsh package",
    "signing:setup-local": "zsh scripts/setup-local-macos-signing.zsh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@bridge/protocol": "0.4.2",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "cross-env": "^10.0.0",
    "electron": "^43.1.1",
    "esbuild": "^0.25.9"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.218",
    "node-datachannel": "0.32.3"
  }
}
