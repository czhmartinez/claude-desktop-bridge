{
  "name": "@bridge/desktop",
  "productName": "Bridge",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "npm run build -w @bridge/client && node scripts/build.mjs",
    "build:bundle": "node scripts/build.mjs",
    "build:main": "node scripts/build.mjs --main-only",
    "clean": "rm -rf dist out coverage",
    "dev": "npm run build:main && cross-env BRIDGE_DEV_SERVER_URL=http://localhost:5188 electron .",
    "make": "npm run build && electron-forge make",
    "package": "npm run build && electron-forge package",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@bridge/protocol": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "cross-env": "^10.0.0",
    "electron": "^43.1.1",
    "esbuild": "^0.25.9",
    "zod": "^4.1.5"
  }
}
